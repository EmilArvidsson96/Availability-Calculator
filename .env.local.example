# Copy this file to .env.local (already gitignored — never commit the real
# values) to enable the login gate for local dev. Leave VITE_AUTH_PASSWORD_HASH
# unset/empty to disable the gate entirely (the default if .env.local doesn't
# exist at all).
#
# The same two values are set as GitHub Actions repository secrets
# (AUTH_USERNAME / AUTH_PASSWORD_HASH) so the deployed GitHub Pages build is
# gated the same way — see README.md.

# Shown on the login screen. Not secret.
VITE_AUTH_USERNAME=admin

# SHA-256 hex digest of the password — NEVER put the plaintext password here.
# Generate with: npm run hash-password -- "your-password"
VITE_AUTH_PASSWORD_HASH=
