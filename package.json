{
  "name": "bess-availability-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual drag-and-drop availability calculator for BESS assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
